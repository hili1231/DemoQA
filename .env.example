# Copy to .env. Node 22+ loads this through process.loadEnvFile().
BASE_URL=https://demoqa.com
HEADLESS=true
BROWSER=chromium
REGISTRATION_MODE=api
# Set MOBILE=true for a mobile web viewport (desktop is the default).
MOBILE=false
# Optional, local debugging only: traces can contain disposable test credentials.
CAPTURE_TRACE=false
