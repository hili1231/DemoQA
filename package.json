{
  "name": "demoqa-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "DemoQA browser tests with Playwright and Cucumber in JavaScript",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "test": "npm run test:web",
    "test:web": "cucumber-js",
    "test:web:dry": "cucumber-js --dry-run --format progress",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@playwright/test": "1.63.0",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2"
  }
}
